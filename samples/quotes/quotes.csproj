<Project Sdk = "Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<!--
		This sample declares a top level 'quotes' command, so the executable cannot also be named
		'quotes': System.CommandLine builds one token table from the root command name and its
		subcommand names, and the duplicate would make every parse fail. 'scl' matches the
		executable name used by the System.CommandLine tutorial this sample is based on.
		-->
		<AssemblyName>scl</AssemblyName>
	</PropertyGroup>

	<!-- 
	Normally you will NOT need following lines because SnapCLI Nuget will take care of this.
	To simplify this project build we don't use nuget here but directly referencing SnapCLI 
	as class library and therefore have to include these references manually.
	-->
	<ItemGroup>
		<ProjectReference Include = "..\..\src\SnapCLI.csproj" />
	</ItemGroup>
	<Import Project = "..\..\src\build\SnapCLI.props" />
	<Import Project = "..\..\src\build\SnapCLI.targets" />

</Project>
